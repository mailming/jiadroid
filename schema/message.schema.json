{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jiadroid message",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "kind", "op"],
  "properties": {
    "v": { "const": 1 },
    "kind": { "enum": ["req", "res", "evt"] },
    "op": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "body": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": ["unknown_device", "out_of_range", "unsupported", "safety_blocked"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "req" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["id", "body"],
        "not": { "required": ["error"] }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "evt" } },
        "required": ["kind"]
      },
      "then": {
        "required": ["body"],
        "not": { "required": ["error"] }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "res" } },
        "required": ["error"]
      },
      "then": {
        "required": ["id", "error"],
        "not": { "required": ["body"] }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "res" } },
        "required": ["kind"],
        "not": { "required": ["error"] }
      },
      "then": {
        "required": ["id", "body"]
      }
    }
  ]
}
