<mujoco model="open_duck_mini_v2_scene">
  <!--
    Flat floor scene for the Open Duck Mini v2, after
    playground/open_duck_mini_v2/xmls/scene_flat_terrain.xml in Open Duck
    Playground (Apache-2.0). The `home` keyframe is the runtime's `init_pos`.
  -->
  <include file="open_duck_mini_v2.xml"/>

  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.95 0.94 0.9" rgb2="0.75 0.8 0.9" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.92 0.9 0.86" rgb2="0.8 0.78 0.72"
      markrgb="0.4 0.4 0.4" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <body name="floor">
      <geom name="floor" size="0 0 0.01" type="plane" material="groundplane" contype="1" conaffinity="0"
        priority="1" friction="0.6" condim="3"/>
    </body>
  </worldbody>

  <keyframe>
    <key name="home"
      qpos="0 0 0.15
            1 0 0 0
            0.002 0.053 -0.63 1.368 -0.784
            0 0 0 0
            -0.003 -0.065 0.635 1.379 -0.796"
      ctrl="0.002 0.053 -0.63 1.368 -0.784
            0 0 0 0
            -0.003 -0.065 0.635 1.379 -0.796"/>
  </keyframe>
</mujoco>
